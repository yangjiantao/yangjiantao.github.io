---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MotionGrid from '../components/MotionGrid.astro';
import { profile } from '../data/profile';
---
<Base>
  <section class="hero section-shell" aria-labelledby="hero-title">
    <div class="hero-content">
      <div class="hero-intro"><span class="eyebrow">JIANTAO YANG / 杨剑涛</span><span class="hero-role">DEVELOPER & MAKER</span></div>
      <h1 id="hero-title" class="hero-title"><span class="hero-line">Logic.</span><span class="hero-line">Feeling.</span><span class="hero-line accent-text">Play<span class="title-dot">.</span></span></h1>
      <div class="hero-description"><p>用清晰的逻辑，<br />创造好玩的体验。</p><span>ANDROID · INTERACTION · INDEPENDENT GAMES</span></div>
      <a href="#work" class="text-link hero-cta">探索我的作品 <span class="link-circle"><Icon size={18} /></span></a>
    </div>
    <MotionGrid />
    <div class="hero-bottom"><span class="eyebrow">把复杂留给代码，把简单留给体验。</span><a href="#work" class="scroll-cue">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
  </section>

  <section id="work" class="work-section section-shell" aria-labelledby="work-title">
    <div class="section-heading" data-reveal><span class="eyebrow">01 / SELECTED WORK</span><h2 id="work-title">把想法，<br />变成可以<span class="serif-word">触碰</span>的东西。</h2><p>从移动应用的基础能力，<br />到一局让人会心一笑的谜题。</p></div>
    <article class="featured-project" data-reveal>
      <a class="project-visual" href="/projects/pandadoku/" aria-label="了解熊猫数独项目">
        <div class="project-visual-heading"><span>PANDADOKU</span><span>独立游戏 / 2026</span></div>
        <div class="project-art">
          <div class="project-big-type" aria-hidden="true">A little<br />panda.<br /><em>A big idea.</em></div>
          <div class="phone-shot phone-back"><img src="/images/pandadoku-home.png" alt="熊猫数独首页实际游戏画面" width="540" height="960" loading="lazy" /></div>
          <div class="phone-shot phone-front"><img src="/images/pandadoku-board.png" alt="熊猫数独的彩色分区棋盘" width="540" height="960" loading="lazy" /></div>
        </div>
        <div class="project-visual-bottom"><span>在一点点秩序里，找到一点点快乐。</span><span class="project-open"><Icon size={24} /></span></div>
      </a>
      <div class="project-info"><div><span class="eyebrow">FEATURED PROJECT / 001</span><h3>熊猫数独<span>Pandadoku</span></h3></div><div class="project-summary"><p>一款以颜色分区和熊猫为主角的逻辑解谜游戏。把规则变得直观，把每次小小的发现变得有趣。</p><div class="tags"><span>Godot</span><span>Android</span><span>逻辑解谜</span></div><a class="text-link" href="/projects/pandadoku/">探索项目 <Icon size={17} /></a></div></div>
    </article>
    <div class="practice-heading" data-reveal><span class="eyebrow">MORE OF MY PRACTICE</span><span>一路积累的产品与工程经验</span></div>
    <a href="/resume/#experience" class="practice-row" data-reveal><span class="practice-index">02</span><div><h3>移动应用与 SDK</h3><p>Android · IM · 基础组件</p></div><span class="practice-description">为真实业务，构建可靠的基础能力。</span><Icon size={25} /></a>
    <a href="/resume/#experience" class="practice-row" data-reveal><span class="practice-index">03</span><div><h3>架构与团队协作</h3><p>Architecture · CI · Engineering</p></div><span class="practice-description">让复杂系统，也有清晰的秩序。</span><Icon size={25} /></a>
  </section>

  <section class="statement-section" aria-label="开发理念"><div class="statement-inner"><span class="eyebrow">THE WAY I MAKE</span><p data-statement>好的体验，<br />藏在<span>每一个细节</span>里。</p><div class="statement-grid" aria-hidden="true">{Array.from({length:9},()=> <i />)}</div><span class="statement-note">THOUGHTFUL BY DESIGN. PLAYFUL BY NATURE.</span></div></section>

  <section id="about" class="about-section section-shell" aria-labelledby="about-title">
    <div class="about-heading" data-reveal><span class="eyebrow">02 / A BIT ABOUT ME</span><h2 id="about-title">你好，<br />我是剑涛<span class="accent-text">。</span></h2><a href="/resume/" class="text-link">查看个人简历 <Icon size={18} /></a></div>
    <div class="about-copy" data-reveal><p class="about-lead">喜欢把复杂的问题理清楚，<br />也喜欢给严谨的系统，<br />留一点好玩的空间。</p><p>{profile.description}</p><p>经历过 SDK、移动应用和团队协作的不同阶段，也在持续探索独立产品的可能。对我来说，开发的乐趣来自让一个想法真正落地。</p><div class="about-principles"><div><span>01</span><h3>清晰</h3><p>让逻辑可理解</p></div><div><span>02</span><h3>细腻</h3><p>让交互有回应</p></div><div><span>03</span><h3>好玩</h3><p>让产品有温度</p></div></div></div>
  </section>
</Base>
