---
import Base from '../layouts/Base.astro';
import { profile, resume, experience, strengths } from '../data/profile';
---
<Base title="个人简历 · 杨剑涛 / Jiantao Yang" description={resume.description}>
  <section class="page-intro section-shell">
    <div class="breadcrumb"><a href="/">首页</a><span>/</span><span>个人简历</span></div>
    <span class="eyebrow">03 / EXPERIENCE & PRACTICE</span>
    <h1>{profile.name}<span class="accent-text">。</span></h1>
    <p class="page-subtitle">{resume.headline}</p>
    <div class="resume-intro-bottom">
      <div class="resume-contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub / yangjiantao</a>
        <a href="/">yangjiantao.github.io</a>
      </div>
      <button class="print-resume" type="button" data-print hidden>打印 / 保存为 PDF</button>
    </div>
  </section>
  <div class="section-shell">
    <section class="resume-section" aria-labelledby="summary-title">
      <h2 id="summary-title"><span>01 / PROFILE</span>个人简介</h2>
      <div class="resume-summary" data-reveal>{resume.summary.map(paragraph => <p>{paragraph}</p>)}</div>
    </section>
    <section class="resume-section" aria-labelledby="strengths-title">
      <h2 id="strengths-title"><span>02 / STRENGTHS</span>核心优势</h2>
      <div class="skill-groups" data-reveal>{strengths.map(item => <div class="skill-group"><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>
    </section>
    <section class="resume-section" id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title"><span>03 / CAREER</span>工作经历</h2>
      <div>{experience.map(item => <article class="experience-item" data-reveal>
        <div class="experience-top"><h3>{item.company}</h3><time>{item.period}</time></div>
        <p class="experience-role">{item.role}</p>
        {item.context && <p class="experience-context">{item.context}</p>}
        <ul class="experience-details">{item.details.map(detail => <li>{detail.label && <strong>{detail.label}：</strong>}{detail.text}</li>)}</ul>
      </article>)}</div>
    </section>
    <section class="resume-section" aria-labelledby="skills-title">
      <h2 id="skills-title"><span>04 / TOOLKIT</span>技术能力</h2>
      <p class="resume-text" data-reveal>{resume.technology}</p>
    </section>
    <section class="resume-section" aria-labelledby="education-title">
      <h2 id="education-title"><span>05 / EDUCATION</span>教育经历</h2>
      <div class="education" data-reveal><h3>{resume.education.school}</h3><p>{resume.education.degree}</p><p>{resume.education.period}</p></div>
    </section>
    <section class="resume-section" aria-labelledby="interests-title">
      <h2 id="interests-title"><span>06 / OUTSIDE WORK</span>兴趣爱好</h2>
      <p class="resume-text" data-reveal>{resume.interests}</p>
    </section>
  </div>
</Base>
